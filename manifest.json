{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.2",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "homepage_url": "https://github.com/neteinstein/Scam-Detector",
  "author": {
    "email": "pedro.vicente@mindera.com"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/lib/punycode.js",
        "src/lib/domain.js",
        "src/lib/brands.js",
        "src/lib/tlds.js",
        "src/lib/phrases.js",
        "src/lib/lookalike.js",
        "src/lib/pageSignals.js",
        "src/lib/chatSchemes.js",
        "src/lib/i18n.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Scam Detector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
